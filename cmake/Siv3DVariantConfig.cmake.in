@PACKAGE_INIT@

# One build of Siv3D, loaded by Siv3DConfig.cmake.

# The MSVC C runtime Siv3D and its bundled dependencies were built with (empty
# outside MSVC). Consumer targets must use the same kind (static or DLL), e.g.
#   set_property(TARGET app PROPERTY MSVC_RUNTIME_LIBRARY "${Siv3D_MSVC_RUNTIME_LIBRARY}")
set(Siv3D_MSVC_RUNTIME_LIBRARY "@SIV3D_MSVC_RUNTIME_LIBRARY@")

# ----------------------------------------------------------------------------
# Siv3D::Siv3D — the fat all-dependencies lib (default install). A raw archive,
# so its usage requirements (C++23, flags, system libs) are attached here.
# Defined only where a fat lib exists (an install prefix, not the build tree):
# Siv3D for Release (also used by RelWithDebInfo and MinSizeRel) and Siv3Dd
# for Debug, each installed with its configuration. A consumer configuration
# with no matching build gets the other one.
# ----------------------------------------------------------------------------
set(_siv3d_fat_dir "${PACKAGE_PREFIX_DIR}/@SIV3D_INSTALL_VARIANT_LIBDIR@")
set(_siv3d_fat_release "${_siv3d_fat_dir}/${CMAKE_STATIC_LIBRARY_PREFIX}Siv3D${CMAKE_STATIC_LIBRARY_SUFFIX}")
set(_siv3d_fat_debug "${_siv3d_fat_dir}/${CMAKE_STATIC_LIBRARY_PREFIX}Siv3Dd${CMAKE_STATIC_LIBRARY_SUFFIX}")
if((EXISTS "${_siv3d_fat_release}" OR EXISTS "${_siv3d_fat_debug}") AND NOT TARGET Siv3D::Siv3D)
    if(NOT WIN32)
        include(CMakeFindDependencyMacro)
        find_dependency(Threads)
    endif()
    add_library(Siv3D::Siv3D STATIC IMPORTED)
    if(EXISTS "${_siv3d_fat_release}")
        set_property(TARGET Siv3D::Siv3D APPEND PROPERTY IMPORTED_CONFIGURATIONS RELEASE)
        set_target_properties(Siv3D::Siv3D PROPERTIES
            IMPORTED_LOCATION_RELEASE "${_siv3d_fat_release}"
            MAP_IMPORTED_CONFIG_RELWITHDEBINFO RELEASE
            MAP_IMPORTED_CONFIG_MINSIZEREL RELEASE)
    endif()
    if(EXISTS "${_siv3d_fat_debug}")
        set_property(TARGET Siv3D::Siv3D APPEND PROPERTY IMPORTED_CONFIGURATIONS DEBUG)
        set_target_properties(Siv3D::Siv3D PROPERTIES
            IMPORTED_LOCATION_DEBUG "${_siv3d_fat_debug}")
    endif()
    set_target_properties(Siv3D::Siv3D PROPERTIES
        # Siv3D headers + the bundled third-party headers (sibling dir).
        INTERFACE_INCLUDE_DIRECTORIES "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_INCLUDEDIR@/Siv3D;${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_INCLUDEDIR@/Siv3D-thirdparty"
        INTERFACE_COMPILE_FEATURES "cxx_std_23"
        INTERFACE_COMPILE_OPTIONS "@SIV3D_PUBLIC_COMPILE_OPTIONS@"
        INTERFACE_COMPILE_DEFINITIONS "@SIV3D_PUBLIC_COMPILE_DEFINITIONS@"
        INTERFACE_LINK_LIBRARIES "@SIV3D_FAT_SYSTEM_LIBS@"
    )
endif()
unset(_siv3d_fat_dir)
unset(_siv3d_fat_release)
unset(_siv3d_fat_debug)

# ----------------------------------------------------------------------------
# Siv3D::Siv3DCore — engine archive + deps from the bundled vcpkg tree. Present
# only with the 'Develop' component (detected via Siv3DCoreTargets.cmake).
# ----------------------------------------------------------------------------
if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/Siv3DCoreTargets.cmake")
    include(CMakeFindDependencyMacro)

    # Resolve deps from the bundled tree (no external vcpkg). Skipped in the
    # build tree (no bundle), where the toolchain provides this.
    set(_siv3d_vcpkg "${PACKAGE_PREFIX_DIR}/@SIV3D_VCPKG_BUNDLE_RELDIR@/@VCPKG_TARGET_TRIPLET@")
    if(IS_DIRECTORY "${_siv3d_vcpkg}")
        if(NOT DEFINED VCPKG_TARGET_TRIPLET)
            set(VCPKG_TARGET_TRIPLET "@VCPKG_TARGET_TRIPLET@")
        endif()
        set(VCPKG_INSTALLED_DIR "${PACKAGE_PREFIX_DIR}/@SIV3D_VCPKG_BUNDLE_RELDIR@")
        set(_VCPKG_INSTALLED_DIR "${VCPKG_INSTALLED_DIR}")
        list(PREPEND CMAKE_PREFIX_PATH "${_siv3d_vcpkg}")
        include("${CMAKE_CURRENT_LIST_DIR}/Siv3DVcpkgShim.cmake")
    endif()
    unset(_siv3d_vcpkg)

    # Generated from SIV3D_DEPENDENCIES in CMakeLists.txt.
@SIV3D_FIND_DEPENDENCY_CALLS@
    if(NOT WIN32 AND NOT APPLE)
        # libuuid (PkgConfig::UUID in Siv3DCore's link interface) ships only a
        # pkg-config file, no CMake package.
        find_package(PkgConfig QUIET)
        if(PkgConfig_FOUND)
            pkg_check_modules(UUID IMPORTED_TARGET uuid)
        endif()
    endif()

    include("${CMAKE_CURRENT_LIST_DIR}/Siv3DCoreTargets.cmake")

    # Map any unbuilt configuration to an installed one so multi-config
    # generators do not error on a missing IMPORTED_LOCATION.
    get_target_property(_siv3d_configs Siv3D::Siv3DCore IMPORTED_CONFIGURATIONS)
    if(_siv3d_configs)
        foreach(_siv3d_cfg DEBUG RELEASE MINSIZEREL RELWITHDEBINFO)
            if(NOT "${_siv3d_cfg}" IN_LIST _siv3d_configs)
                if(_siv3d_cfg STREQUAL "DEBUG")
                    set(_siv3d_pref RELEASE RELWITHDEBINFO MINSIZEREL)
                else()
                    set(_siv3d_pref RELEASE RELWITHDEBINFO MINSIZEREL DEBUG)
                endif()
                foreach(_siv3d_candidate IN LISTS _siv3d_pref)
                    if("${_siv3d_candidate}" IN_LIST _siv3d_configs)
                        set_target_properties(Siv3D::Siv3DCore PROPERTIES
                            "MAP_IMPORTED_CONFIG_${_siv3d_cfg}" "${_siv3d_candidate}")
                        break()
                    endif()
                endforeach()
            endif()
        endforeach()
        unset(_siv3d_pref)
        unset(_siv3d_candidate)
    endif()
    unset(_siv3d_configs)
endif()

check_required_components(Siv3D)
