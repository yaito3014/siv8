# Script mode (cmake -P): checks that the CMake build compiles the sources a
# Visual Studio project compiles, with the same per-file settings, and lists
# the same headers.
#   -DVCXPROJ=<project> -DFACTS=<file written by siv3d_finish_sources()>
#   -DROOT=<repository root>
#
# The project's ClCompile, ResourceCompile and ClInclude items become facts in
# the form siv3d_finish_sources() writes; headers go in the CMake build's
# header file sets. Recognized per-file metadata, each optionally
# conditioned on '$(Configuration)|$(Platform)'=='<Debug|Release>|x64':
#   WarningLevel, DisableSpecificWarnings, PreprocessorDefinitions (those the
#   project defines for every file are left out) and
#   AdditionalIncludeDirectories (both ending in their %(...) inheritance),
#   ExcludedFromBuild, PrecompiledHeader (NotUsing; Create is left out, since
#   CMake makes its own precompiled header), and an empty ForcedIncludeFiles.
# Anything else fails the check rather than being skipped.
cmake_minimum_required(VERSION 3.25)

string(ASCII 1 _semicolon)

function(_fail _message)
    message(FATAL_ERROR "${VCXPROJ}: ${_message}")
endfunction()

# Sets <out_var> to the configurations a Condition attribute selects.
function(_configs _condition _out_var)
    if(_condition STREQUAL "")
        set(${_out_var} Debug Release PARENT_SCOPE)
    elseif(_condition MATCHES "^'\\$\\(Configuration\\)\\|\\$\\(Platform\\)'=='(Debug|Release)\\|x64'$")
        set(${_out_var} ${CMAKE_MATCH_1} PARENT_SCOPE)
    else()
        _fail("unsupported Condition ${_condition}")
    endif()
endfunction()

# Splits an MSBuild list value, which must end with its %(<name>) inheritance.
function(_list _value _name _out_var)
    string(REPLACE "${_semicolon}" ";" _items "${_value}")
    list(TRANSFORM _items STRIP)
    list(REMOVE_ITEM _items "")
    list(POP_BACK _items _last)
    if(NOT _last STREQUAL "%(${_name})")
        _fail("${_name} '${_value}' does not end in %(${_name})")
    endif()
    set(${_out_var} "${_items}" PARENT_SCOPE)
endfunction()

get_filename_component(_dir "${VCXPROJ}" DIRECTORY)
file(READ "${VCXPROJ}" _content)
string(REPLACE ";" "${_semicolon}" _content "${_content}")
string(REPLACE "\r" "" _content "${_content}")
string(REPLACE "\n" ";" _lines "${_content}")

# Project-wide definitions, per configuration.
set(_group "")
foreach(_line IN LISTS _lines)
    string(STRIP "${_line}" _line)
    if(_line MATCHES "^<ItemDefinitionGroup Condition=\"([^\"]*)\">$")
        _configs("${CMAKE_MATCH_1}" _group)
    elseif(_line STREQUAL "</ItemDefinitionGroup>")
        set(_group "")
    elseif(_group AND _line MATCHES "^<PreprocessorDefinitions>(.*)</PreprocessorDefinitions>$")
        _list("${CMAKE_MATCH_1}" PreprocessorDefinitions _items)
        foreach(_config IN LISTS _group)
            set(_project_definitions_${_config} ${_items})
        endforeach()
    endif()
endforeach()

set(_facts "")
set(_file "")
foreach(_line IN LISTS _lines)
    string(STRIP "${_line}" _line)
    if(_file STREQUAL "")
        if(_line MATCHES "^<(ClCompile|ResourceCompile|ClInclude) Include=\"([^\"]+)\"( /)?>$")
            string(REPLACE "\\" "/" _path "${CMAKE_MATCH_2}")
            get_filename_component(_file "${_path}" ABSOLUTE BASE_DIR "${_dir}")
            file(RELATIVE_PATH _file "${ROOT}" "${_file}")
            set(_kind "${CMAKE_MATCH_1}")
            set(_excluded FALSE)
            set(_item_facts "")
            if(CMAKE_MATCH_3)
                set(_line "</${_kind}>")
            else()
                continue()
            endif()
        elseif(_line MATCHES "^<(ClCompile|ResourceCompile|ClInclude) ")
            _fail("unsupported item ${_line}")
        else()
            continue()
        endif()
    endif()

    if(_line STREQUAL "</${_kind}>")
        if(_kind STREQUAL "ClInclude")
            list(APPEND _facts "${_file}|*|header|")
        elseif(NOT _excluded)
            list(APPEND _facts "${_file}|*|source|" ${_item_facts})
        endif()
        set(_file "")
        continue()
    endif()
    if(_kind STREQUAL "ClInclude")
        _fail("unsupported metadata on ClInclude ${_file}: ${_line}")
    endif()

    if(NOT _line MATCHES "^<([A-Za-z]+)( Condition=\"([^\"]*)\")?( />|>(.*)</[A-Za-z]+>)$")
        _fail("unsupported line in ${_kind} ${_file}: ${_line}")
    endif()
    set(_key "${CMAKE_MATCH_1}")
    set(_value "${CMAKE_MATCH_5}")
    set(_conditional "${CMAKE_MATCH_3}")
    _configs("${_conditional}" _item_configs)

    if(_key STREQUAL "WarningLevel")
        if(_value MATCHES "^Level([1-4])$")
            set(_level ${CMAKE_MATCH_1})
        elseif(_value STREQUAL "TurnOffAllWarnings")
            set(_level 0)
        else()
            _fail("unsupported WarningLevel ${_value} on ${_file}")
        endif()
        foreach(_config IN LISTS _item_configs)
            list(APPEND _item_facts "${_file}|${_config}|warning|${_level}")
        endforeach()
    elseif(_key STREQUAL "DisableSpecificWarnings")
        string(REPLACE "${_semicolon}" ";" _numbers "${_value}")
        list(TRANSFORM _numbers STRIP)
        list(REMOVE_ITEM _numbers "" "%(DisableSpecificWarnings)")
        foreach(_number IN LISTS _numbers)
            if(NOT _number MATCHES "^[0-9]+$")
                _fail("unsupported DisableSpecificWarnings ${_value} on ${_file}")
            endif()
            foreach(_config IN LISTS _item_configs)
                list(APPEND _item_facts "${_file}|${_config}|nowarn|${_number}")
            endforeach()
        endforeach()
    elseif(_key STREQUAL "PreprocessorDefinitions")
        _list("${_value}" PreprocessorDefinitions _items)
        foreach(_config IN LISTS _item_configs)
            foreach(_item IN LISTS _items)
                if(NOT _item IN_LIST _project_definitions_${_config})
                    list(APPEND _item_facts "${_file}|${_config}|define|${_item}")
                endif()
            endforeach()
        endforeach()
    elseif(_key STREQUAL "AdditionalIncludeDirectories")
        _list("${_value}" AdditionalIncludeDirectories _items)
        foreach(_item IN LISTS _items)
            # $(SolutionDir) and $(ProjectDir) are the project's own directory
            # here, with a trailing separator.
            string(REGEX REPLACE "^\\$\\((SolutionDir|ProjectDir)\\)" "${_dir}/" _item "${_item}")
            string(REPLACE "\\" "/" _item "${_item}")
            if(_item MATCHES "\\$\\(")
                _fail("unsupported macro in AdditionalIncludeDirectories ${_value} on ${_file}")
            endif()
            get_filename_component(_item "${_item}" ABSOLUTE BASE_DIR "${_dir}")
            file(RELATIVE_PATH _item "${ROOT}" "${_item}")
            foreach(_config IN LISTS _item_configs)
                list(APPEND _item_facts "${_file}|${_config}|include|${_item}")
            endforeach()
        endforeach()
    elseif(_key STREQUAL "ExcludedFromBuild")
        string(TOLOWER "${_value}" _value)
        if(NOT _conditional STREQUAL "" OR NOT _value MATCHES "^(true|false)$")
            _fail("unsupported ExcludedFromBuild on ${_file}")
        endif()
        if(_value STREQUAL "true")
            set(_excluded TRUE)
        endif()
    elseif(_key STREQUAL "PrecompiledHeader")
        if(_value STREQUAL "NotUsing" AND _conditional STREQUAL "")
            list(APPEND _item_facts "${_file}|*|nopch|")
        elseif(NOT _value STREQUAL "Create")
            _fail("unsupported PrecompiledHeader ${_value} on ${_file}")
        endif()
    elseif(_key STREQUAL "ForcedIncludeFiles")
        if(NOT _value STREQUAL "")
            _fail("unsupported ForcedIncludeFiles ${_value} on ${_file}")
        endif()
    else()
        _fail("unsupported ${_kind} metadata ${_key} on ${_file}")
    endif()
endforeach()

file(STRINGS "${FACTS}" _cmake_facts)
list(REMOVE_DUPLICATES _facts)
set(_missing ${_facts})
list(REMOVE_ITEM _missing ${_cmake_facts})
set(_extra ${_cmake_facts})
list(REMOVE_ITEM _extra ${_facts})
if(_missing OR _extra)
    foreach(_side _missing _extra)
        if(${_side})
            list(JOIN ${_side} "\n  " ${_side})
        else()
            set(${_side} "(none)")
        endif()
    endforeach()
    message(FATAL_ERROR "The CMake build differs from ${VCXPROJ} "
        "(<file>|<configuration>|<kind>|<value>).\n"
        "In the project only:\n  ${_missing}\nIn the CMake build only:\n  ${_extra}")
endif()
list(LENGTH _facts _count)
message(STATUS "${VCXPROJ}: CMake build matches (${_count} facts)")
