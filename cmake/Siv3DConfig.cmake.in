@PACKAGE_INIT@

# Siv3D is a static library, so its dependencies (linked PRIVATE, exported as
# $<LINK_ONLY:...>) must still be resolvable in the consuming project at link
# time: from the system, or from the engine build's vcpkg_installed prefix —
# put it on CMAKE_PREFIX_PATH (same triplet and runtime library) — see
# WindowsDesktop/CMakeLists.txt for an example.
include(CMakeFindDependencyMacro)

# When the dependencies come from a vcpkg install tree but this project is
# configured without the vcpkg toolchain, the shim restores the toolchain
# behaviors the port configs rely on (per-port vcpkg-cmake-wrapper dispatch,
# <triplet>/debug search paths). It activates only if a vcpkg installed tree
# is found on CMAKE_PREFIX_PATH and backs off under the real toolchain.
include("${CMAKE_CURRENT_LIST_DIR}/VcpkgShim.cmake")
vcpkg_shim_autodetect()

# CONFIG for the same reason as the engine build: harfbuzz's config insists on
# its own freetype, and a module-mode hit on a different copy would mix two
# freetypes into one static link.
find_dependency(Freetype CONFIG)
find_dependency(harfbuzz CONFIG)
find_dependency(PNG)
find_dependency(libjpeg-turbo CONFIG)
find_dependency(ZLIB)
find_dependency(OpenCV COMPONENTS core imgproc)
find_dependency(mimalloc CONFIG)
find_dependency(oniguruma CONFIG)
find_dependency(Boost @SIV3D_BOOST_MIN_VERSION@ CONFIG COMPONENTS filesystem)
@SIV3D_SKIA_FIND_DEPENDENCY@
if(NOT WIN32)
    find_dependency(glfw3 CONFIG)
    find_dependency(Threads)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/Siv3DTargets.cmake")

# The install tree may carry only a subset of configurations (typically Debug
# and Release), but multi-config generators evaluate every project
# configuration at generate time and error on a missing IMPORTED_LOCATION.
# Map each missing configuration to an installed one; the mapping only takes
# effect if that configuration is actually built (on MSVC, prefer installing
# both Debug and Release so the CRT flavors match).
get_target_property(_siv3d_configs Siv3D::Siv3D IMPORTED_CONFIGURATIONS)
if(_siv3d_configs)
    foreach(_siv3d_cfg DEBUG RELEASE MINSIZEREL RELWITHDEBINFO)
        if(NOT "${_siv3d_cfg}" IN_LIST _siv3d_configs)
            if(_siv3d_cfg STREQUAL "DEBUG")
                set(_siv3d_pref RELEASE RELWITHDEBINFO MINSIZEREL)
            else()
                set(_siv3d_pref RELEASE RELWITHDEBINFO MINSIZEREL DEBUG)
            endif()
            foreach(_siv3d_candidate IN LISTS _siv3d_pref)
                if("${_siv3d_candidate}" IN_LIST _siv3d_configs)
                    set_target_properties(Siv3D::Siv3D PROPERTIES
                        "MAP_IMPORTED_CONFIG_${_siv3d_cfg}" "${_siv3d_candidate}")
                    break()
                endif()
            endforeach()
        endif()
    endforeach()
    unset(_siv3d_pref)
    unset(_siv3d_candidate)
endif()
unset(_siv3d_configs)

check_required_components(Siv3D)
