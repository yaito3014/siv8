{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "siv3d",
  "version-string": "0.8.0",
  "description": "Siv3D (siv8) third-party dependencies managed via vcpkg manifest mode.",
  "homepage": "https://siv3d.github.io/",
  "dependencies": [
    "abseil",
    "boost-filesystem",
    "boost-geometry",
    "boost-process",
    "boost-multiprecision",
    "boost-range",
    "cpu-features",
    "directxmath",
    "double-conversion",
    "drlibs",
    "earcut-hpp",
    "easyexif",
    "fast-float",
    "fmt",
    "freetype",
    "harfbuzz",
    "libjpeg-turbo",
    "libmorton",
    "libpng",
    "lunasvg",
    "mapbox-variant",
    "mimalloc",
    "miniaudio",
    "muparser",
    "nanobench",
    "nanoflann",
    "nlohmann-json",
    "oniguruma",
    "parallel-hashmap",
    "pcg",
    "pffft",
    "plutovg",
    "simdutf",
    "stb",
    "stduuid",
    "wyhash",
    "xxhash",
    "zlib",
    {
      "name": "msdfgen",
      "default-features": false
    },
    {
      "name": "opencv4",
      "default-features": false
    },
    {
      "name": "wintoast",
      "platform": "windows"
    },
    {
      "name": "glfw3",
      "platform": "!windows"
    }
  ],
  "features": {
    "tests": {
      "description": "Unit test framework (Siv3D-Test).",
      "dependencies": [
        "doctest"
      ]
    },
    "skia": {
      "description": "Skia backend (vcpkg ships an UNOFFICIAL port; heavy and may need pinning/overlay).",
      "dependencies": [
        "skia"
      ]
    }
  },
  "builtin-baseline": "b216ddff25a1f432870e6c340ce79357049ef86e",
  "$comment-overrides": "boost-geometry is pinned to 1.88.0: the vendored geometry extensions (Siv3D/src/ThirdParty/boost/geometry/extensions, used by PolygonDetail) include overlay internals removed in boost 1.89+. The pin is per-port, so the rest of boost follows the baseline.",
  "overrides": [
    {
      "name": "boost-geometry",
      "version": "1.88.0"
    }
  ]
}
